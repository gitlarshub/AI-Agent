{
    "servers": {
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
            }
        },
        "figma": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-figma"
            ],
            "env": {
                "FIGMA_TOKEN": "YOUR_FIGMA_TOKEN_HERE"
            }
        }
    }
}